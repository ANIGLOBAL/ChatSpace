{
  "name": "chatspace-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build & node scripts/write-index.mjs",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test:e2e": "node scripts/test-e2e.mjs",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && wrangler dev",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@react-router/dev": "8.4.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "isbot": "^5.2.2",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "8.3.5",
    "wrangler": "^4.158.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "lightningcss@1.33.0": true,
    "workerd@1.20261104.1": true
  }
}
